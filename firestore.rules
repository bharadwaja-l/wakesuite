rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------
    // WakeSuite V9.3.2 Firestore Security Rules
    // Organization: @wakefit.co
    // Access source of truth: access_users/{uid}
    // Super Admin: role == "super_admin"
    // ------------------------------------------------------------

    function orgSignedIn() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.matches('.*@wakefit[.]co$');
    }

    function accessPath() {
      return /databases/$(database)/documents/access_users/$(request.auth.uid);
    }

    function hasAccessDoc() {
      return orgSignedIn() && exists(accessPath());
    }

    function accessData() {
      return get(accessPath()).data;
    }

    function approved() {
      return hasAccessDoc() && accessData().status == 'approved';
    }

    function isSuperAdmin() {
      return approved() && accessData().role == 'super_admin';
    }

    function hasPermission(permissionName) {
      return isSuperAdmin()
        || (approved()
          && ('permissions' in accessData())
          && (permissionName in accessData().permissions)
          && accessData().permissions[permissionName] == true);
    }

    function hasScopes() {
      return approved() && ('scopes' in accessData());
    }

    function hasAllData() {
      return isSuperAdmin()
        || (hasScopes()
          && ('allData' in accessData().scopes)
          && accessData().scopes.allData == true);
    }

    function hasWildcardCategories() {
      return isSuperAdmin()
        || (hasScopes()
          && ('categories' in accessData().scopes)
          && accessData().scopes.categories.hasAny(['*']));
    }

    function marketAllowed(marketplace) {
      return isSuperAdmin()
        || (hasScopes()
          && ('marketplaces' in accessData().scopes)
          && accessData().scopes.marketplaces.hasAny([marketplace]));
    }

    function categoryAllowed(category) {
      return isSuperAdmin()
        || (hasScopes()
          && ('categories' in accessData().scopes)
          && (accessData().scopes.categories.hasAny(['*'])
            || accessData().scopes.categories.hasAny([category])));
    }

    function hasAnyModule(modules) {
      return isSuperAdmin()
        || (hasScopes()
          && ('modules' in accessData().scopes)
          && accessData().scopes.modules.hasAny(modules));
    }

    function scopeAllowed(data) {
      return isSuperAdmin()
        || (approved()
          && (!(data.keys().hasAny(['marketplace']))
            || data.marketplace == ''
            || marketAllowed(data.marketplace))
          && (!(data.keys().hasAny(['category']))
            || data.category == ''
            || data.category == 'all'
            || data.category == '*'
            || categoryAllowed(data.category)));
    }

    function canUploadType(configId) {
      return isSuperAdmin()
        || (hasPermission('upload')
          && (hasAllData()
            || (hasScopes()
              && ('uploadTypes' in accessData().scopes)
              && (accessData().scopes.uploadTypes.hasAny(['*'])
                || accessData().scopes.uploadTypes.hasAny([configId])))));
    }

    function canDownloadType(typeName) {
      return isSuperAdmin()
        || (hasPermission('download')
          && (hasAllData()
            || (hasScopes()
              && ('downloadTypes' in accessData().scopes)
              && (accessData().scopes.downloadTypes.hasAny(['*'])
                || accessData().scopes.downloadTypes.hasAny([typeName])))));
    }

    function canWriteProcessedData() {
      // Current WakeSuite processing writes a full normalized snapshot.
      // Restricted/category-scoped users can upload source files only when
      // their configured upload type allows it, but they cannot write a full
      // organization-wide processed snapshot.
      return isSuperAdmin()
        || (hasPermission('upload') && hasAllData());
    }

    function canDataAdmin() {
      // Super Admin is authoritative for destructive administration.
      return isSuperAdmin();
    }

    function chunkTypeAllowed(typeName) {
      return isSuperAdmin()
        || (approved() && (
          (typeName == 'amazonRows' && hasAnyModule([
            'dashboard','marketplaceInsights','pricingInsights',
            'amazonListing','amazonLive','amazonMrp','amazonPricingIssues',
            'amazonPriceUpdates','amazonMinMaxUpdates','marketplaceData',
            'dailyCommunications','pricingHistory'
          ]))
          || (typeName == 'amazonSuppressions' && hasAnyModule([
            'dashboard','marketplaceInsights','amazonSuppression',
            'suppressionManagement','dailyCommunications'
          ]))
          || (typeName == 'amazonBuyBox' && hasAnyModule([
            'dashboard','marketplaceInsights','amazonBuyBox','dailyCommunications'
          ]))
          || (typeName == 'amazonInventoryRows' && hasAnyModule([
            'inventoryInsights','marketplaceData','inventoryHistory'
          ]))
          || (typeName == 'flipkartRows' && hasAnyModule([
            'dashboard','marketplaceInsights','pricingInsights',
            'flipkartListing','flipkartLive','flipkartMrp','flipkartPriceUpdates',
            'marketplaceData','dailyCommunications','pricingHistory'
          ]))
          || (typeName == 'flipkartInventoryRows' && hasAnyModule([
            'inventoryInsights','marketplaceData','inventoryHistory'
          ]))
        ));
    }

    function batchScopeAllowed(data) {
      return isSuperAdmin()
        || (approved()
          && data.keys().hasAny(['marketplace'])
          && marketAllowed(data.marketplace)
          && (hasAllData()
            || hasWildcardCategories()
            || (data.keys().hasAny(['scopeKeys'])
              && hasScopes()
              && ('scopeKeys' in accessData().scopes)
              && data.scopeKeys.hasOnly(accessData().scopes.scopeKeys))));
    }

    function communicationScopeAllowed(data) {
      return isSuperAdmin()
        || (approved()
          && data.keys().hasAny(['marketplace'])
          && ((data.marketplace == 'combined'
              && hasScopes()
              && accessData().scopes.marketplaces.hasAll(['amazon','flipkart']))
            || (data.marketplace != 'combined' && marketAllowed(data.marketplace))));
    }

    function canReadSuppressionData() {
      return approved()
        && marketAllowed('amazon')
        && hasAnyModule([
          'dashboard','marketplaceInsights','amazonSuppression','amazonBuyBox',
          'suppressionManagement','dailyCommunications'
        ]);
    }

    function suppressionCaseScopeAllowed(data) {
      return canReadSuppressionData()
        && (!(data.keys().hasAny(['category'])) || categoryAllowed(data.category));
    }

    function suppressionAuditScopeAllowed(data) {
      return approved()
        && marketAllowed('amazon')
        && data.keys().hasAny(['caseId'])
        && exists(/databases/$(database)/documents/suppression_cases/$(data.caseId))
        && categoryAllowed(
          get(/databases/$(database)/documents/suppression_cases/$(data.caseId)).data.category
        );
    }

    function suppressionCaseOperationalUpdateAllowed() {
      return suppressionCaseScopeAllowed(resource.data)
        && suppressionCaseScopeAllowed(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'assignees','teamAssigned','owner','status','notes','followUpDate','suppressionState','lastAuditDate',
          'caseId','caseIdRaisedOn',
          'poaStatus','poaSubmittedOn','qcStatus','qcSubmittedOn',
          'pocEscalationStatus','pocEscalatedOn',
          'closedOn','reactivatedOn','reactivatedDate',
          'firstSeen','lastSeen','resolvedOn',
          'updatedBy','updatedAt'
        ])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'assignees','teamAssigned','owner','status','notes','followUpDate','suppressionState','lastAuditDate',
              'closedOn','reactivatedOn','reactivatedDate',
              'firstSeen','lastSeen','resolvedOn'
            ]) || hasPermission('manageSuppressions'))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'caseId','caseIdRaisedOn'
            ]) || hasPermission('raiseCaseId'))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'poaStatus','poaSubmittedOn','qcStatus','qcSubmittedOn'
            ]) || hasPermission('managePoaQc'))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'pocEscalationStatus','pocEscalatedOn'
            ]) || hasPermission('pocEscalation'));
    }

    function invitePathForSignedInEmail() {
      return /databases/$(database)/documents/access_invites/$(request.auth.token.email);
    }

    function canCreateOwnAccessFromInvite(uid) {
      return orgSignedIn()
        && request.auth.uid == uid
        && exists(invitePathForSignedInEmail())
        && get(invitePathForSignedInEmail()).data.status in ['invited','approved']
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'approved'
        && request.resource.data.role == get(invitePathForSignedInEmail()).data.role;
    }

    // ------------------------------------------------------------
    // Access and identity
    // ------------------------------------------------------------

    match /access_users/{uid} {
      allow read: if orgSignedIn() && (
        request.auth.uid == uid
        || isSuperAdmin()
        || hasPermission('userAdmin')
        || hasPermission('manageSuppressions')
      );

      allow create: if isSuperAdmin()
        || hasPermission('userAdmin')
        || canCreateOwnAccessFromInvite(uid);

      allow update, delete: if isSuperAdmin() || hasPermission('userAdmin');
    }

    match /access_requests/{uid} {
      allow read: if orgSignedIn() && (
        request.auth.uid == uid
        || isSuperAdmin()
        || hasPermission('userAdmin')
      );

      allow create: if orgSignedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending';

      allow update: if isSuperAdmin()
        || hasPermission('userAdmin')
        || (orgSignedIn()
          && request.auth.uid == uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.status == 'pending');

      allow delete: if isSuperAdmin() || hasPermission('userAdmin');
    }

    match /access_invites/{email} {
      allow read: if orgSignedIn() && (
        request.auth.token.email == email
        || isSuperAdmin()
        || hasPermission('userAdmin')
      );

      allow create, delete: if isSuperAdmin() || hasPermission('userAdmin');

      allow update: if isSuperAdmin()
        || hasPermission('userAdmin')
        || (orgSignedIn()
          && request.auth.token.email == email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status','acceptedUid','acceptedAt'
          ])
          && request.resource.data.status == 'accepted'
          && request.resource.data.acceptedUid == request.auth.uid);
    }

    // ------------------------------------------------------------
    // Shared configuration and preferences
    // ------------------------------------------------------------

    match /upload_config/{configId} {
      // Config contains source definitions, not marketplace business data.
      // Allow organization users to read it so pending/invited login flows can initialize.
      allow read: if orgSignedIn();
      allow write: if isSuperAdmin() || hasPermission('settings');
    }

    match /system_settings/{settingId} {
      allow read: if approved();
      allow write: if isSuperAdmin()
        || hasPermission('settings')
        || hasPermission('userAdmin');
    }

    match /user_preferences/{uid} {
      allow read, write: if orgSignedIn() && request.auth.uid == uid;
    }

    // ------------------------------------------------------------
    // Upload registration metadata
    // Raw uploaded file bytes are not stored here by the current browser app.
    // ------------------------------------------------------------

    match /uploads/{uploadId} {
      allow create: if approved()
        && hasPermission('upload')
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userEmail == request.auth.token.email
        && request.resource.data.keys().hasAny(['configId'])
        && canUploadType(request.resource.data.configId);

      allow read: if isSuperAdmin()
        || (approved() && resource.data.userId == request.auth.uid)
        || (approved()
          && hasAnyModule(['uploadCenter'])
          && resource.data.keys().hasAny(['configId'])
          && canUploadType(resource.data.configId));

      allow update, delete: if canDataAdmin();
    }

    // ------------------------------------------------------------
    // Master Pricing cache
    // The current cache chunks contain all categories for a marketplace,
    // therefore restricted/category-scoped users must not read the whole cache.
    // ------------------------------------------------------------

    match /master_pricing_cache/{marketplace} {
      allow read: if approved()
        && marketAllowed(marketplace)
        && hasAllData();
      allow create, update, delete: if canWriteProcessedData()
        && marketAllowed(marketplace);

      match /chunks/{chunkId} {
        allow read: if approved()
          && marketAllowed(marketplace)
          && hasAllData();
        allow create, update, delete: if canWriteProcessedData()
          && marketAllowed(marketplace);
      }
    }

    // ------------------------------------------------------------
    // Daily normalized snapshots
    // V7+ snapshots are category/marketplace scoped under /scopes.
    // ------------------------------------------------------------

    match /daily_snapshots/{reportDate} {
      // Metadata contains processing/source status only; row data is in scoped chunks.
      allow read: if approved();
      allow create, update: if canWriteProcessedData();
      allow delete: if canDataAdmin() || canWriteProcessedData();

      // Legacy chunks are not category-scoped. Only all-data users may read them.
      match /chunks/{chunkId} {
        allow read: if approved()
          && hasAllData()
          && chunkTypeAllowed(resource.data.type);
        allow create, update: if canWriteProcessedData();
        allow delete: if canDataAdmin() || canWriteProcessedData();
      }

      match /scopes/{scopeId} {
        allow read: if approved()
          && marketAllowed(resource.data.marketplace)
          && categoryAllowed(resource.data.category);
        allow create, update: if canWriteProcessedData();
        allow delete: if canDataAdmin() || canWriteProcessedData();

        match /chunks/{chunkId} {
          allow read: if approved()
            && marketAllowed(resource.data.marketplace)
            && categoryAllowed(resource.data.category)
            && chunkTypeAllowed(resource.data.type);
          allow create, update: if canWriteProcessedData();
          allow delete: if canDataAdmin() || canWriteProcessedData();
        }
      }
    }

    // ------------------------------------------------------------
    // Pricing Exceptions
    // ------------------------------------------------------------

    match /pricing_exceptions/{exceptionId} {
      allow read: if approved()
        && scopeAllowed(resource.data)
        && hasAnyModule([
          'dashboard','marketplaceInsights','pricingInsights',
          'amazonListing','amazonLive','amazonMrp','amazonPriceUpdates',
          'flipkartListing','flipkartLive','flipkartMrp','flipkartPriceUpdates',
          'pricingExceptions','marketplaceData'
        ]);

      allow create: if hasPermission('managePricingExceptions')
        && scopeAllowed(request.resource.data);

      allow update: if hasPermission('managePricingExceptions')
        && scopeAllowed(resource.data)
        && scopeAllowed(request.resource.data);

      // Normal users remove exceptions through status="removed".
      // Permanent document deletion is Super Admin/Data Administration only.
      allow delete: if canDataAdmin();
    }

    // Dedicated Amazon Min/Max "No Pricing Issue" store.
    match /amazon_pricing_issue_overrides/{overrideId} {
      allow read: if approved()
        && marketAllowed('amazon')
        && (!(resource.data.keys().hasAny(['category']))
          || categoryAllowed(resource.data.category));

      allow create: if (hasPermission('priceUpdates')
          || hasPermission('managePricingExceptions'))
        && marketAllowed('amazon')
        && (!(request.resource.data.keys().hasAny(['category']))
          || categoryAllowed(request.resource.data.category));

      allow update: if (hasPermission('priceUpdates')
          || hasPermission('managePricingExceptions'))
        && marketAllowed('amazon')
        && (!(resource.data.keys().hasAny(['category']))
          || categoryAllowed(resource.data.category))
        && (!(request.resource.data.keys().hasAny(['category']))
          || categoryAllowed(request.resource.data.category));

      allow delete: if canDataAdmin();
    }

    // ------------------------------------------------------------
    // Suppression operations
    // ------------------------------------------------------------

    match /suppression_overrides/{overrideId} {
      allow read: if approved()
        && marketAllowed('amazon')
        && (!(resource.data.keys().hasAny(['category']))
          || categoryAllowed(resource.data.category));

      allow create: if hasPermission('suppressionOverride')
        && marketAllowed('amazon')
        && (!(request.resource.data.keys().hasAny(['category']))
          || categoryAllowed(request.resource.data.category));

      allow update: if hasPermission('suppressionOverride')
        && marketAllowed('amazon')
        && (!(resource.data.keys().hasAny(['category']))
          || categoryAllowed(resource.data.category))
        && (!(request.resource.data.keys().hasAny(['category']))
          || categoryAllowed(request.resource.data.category));

      allow delete: if canDataAdmin();
    }

    match /suppression_cases/{caseId} {
      allow read: if suppressionCaseScopeAllowed(resource.data);

      // Automatic snapshot processing may create/update lifecycle cases.
      // Manual case creation requires Raise Case ID permission.
      allow create: if canWriteProcessedData()
        || (hasPermission('raiseCaseId')
          && marketAllowed('amazon')
          && (!(request.resource.data.keys().hasAny(['category']))
            || categoryAllowed(request.resource.data.category)));

      allow update: if canWriteProcessedData()
        || suppressionCaseOperationalUpdateAllowed();

      allow delete: if canDataAdmin();
    }

    match /suppression_case_audit/{auditId} {
      allow read: if suppressionAuditScopeAllowed(resource.data)
        && hasAnyModule(['suppressionManagement']);

      allow create: if suppressionAuditScopeAllowed(request.resource.data)
        && (hasPermission('manageSuppressions')
          || hasPermission('raiseCaseId')
          || hasPermission('managePoaQc')
          || hasPermission('pocEscalation')
          || hasPermission('suppressionOverride'));

      allow update, delete: if canDataAdmin();
    }

    match /poc_escalations/{escalationId} {
      allow read: if hasPermission('pocEscalation')
        && scopeAllowed(resource.data);

      allow create: if hasPermission('pocEscalation')
        && scopeAllowed(request.resource.data);

      allow update: if hasPermission('pocEscalation')
        && scopeAllowed(resource.data)
        && scopeAllowed(request.resource.data);

      allow delete: if canDataAdmin();
    }

    // ------------------------------------------------------------
    // Marketplace Price Update generation / verification
    // ------------------------------------------------------------

    match /marketplace_update_batches/{batchId} {
      allow read: if approved()
        && hasPermission('download')
        && batchScopeAllowed(resource.data);

      allow create: if hasPermission('priceUpdates')
        && batchScopeAllowed(request.resource.data);

      allow update: if hasPermission('priceUpdates')
        && batchScopeAllowed(resource.data)
        && batchScopeAllowed(request.resource.data);

      allow delete: if canDataAdmin();

      match /chunks/{chunkId} {
        allow read: if approved()
          && hasPermission('download')
          && batchScopeAllowed(
            get(/databases/$(database)/documents/marketplace_update_batches/$(batchId)).data
          );

        allow create, update: if hasPermission('priceUpdates')
          && batchScopeAllowed(
            get(/databases/$(database)/documents/marketplace_update_batches/$(batchId)).data
          );

        allow delete: if canDataAdmin();
      }
    }

    // ------------------------------------------------------------
    // Daily communications
    // ------------------------------------------------------------

    match /communication_log/{communicationId} {
      allow read: if hasPermission('email')
        && communicationScopeAllowed(resource.data);

      allow create: if hasPermission('email')
        && communicationScopeAllowed(request.resource.data);

      allow update, delete: if canDataAdmin();
    }

    // ------------------------------------------------------------
    // Super Admin audit log
    // ------------------------------------------------------------

    match /system_audit_log/{auditId} {
      allow read, create, update, delete: if canDataAdmin();
    }

    // ------------------------------------------------------------
    // Deny everything not explicitly covered above.
    // ------------------------------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
